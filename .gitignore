# Rebuilt per machine by install.sh, and deliberately not shared.
node_modules/

# A frozen copy of whichever node the installing machine has. 68M, and the
# Accessibility grant is tied to this exact path on this exact Mac, so copying
# one between machines buys nothing.
bin/

# Compiled from mousehelper.swift at install time.
mousehelper

# Compiled from permissions.swift at install time.
permissions

padctl.log
.DS_Store

# Yours, not mine. install.sh seeds it from config.example.json.
# My own is committed at configs/g.json if you want it as a starting point.
config.json
config.json.bak

# The built .app, 72MB and rebuilt by scripts/build-app.sh
build/
